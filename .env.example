# Docker Compose / NestJS 生产环境示例。复制为服务器上的 .env 后替换所有 CHANGE_ME。
NODE_ENV=production
PORT=9000
API_PREFIX=api
FRONTEND_ORIGIN=http://47.243.170.126
CORS_ORIGIN=http://47.243.170.126

JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_AT_LEAST_32_CHARS
JWT_REFRESH_EXPIRES_IN=30d
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_ENCRYPTION_KEY

# 当前应用已把 RBAC 与业务数据迁移到 PostgreSQL；这些 MySQL 字段仅满足旧配置兼容。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=unused
MYSQL_PASSWORD=CHANGE_ME_UNUSED
MYSQL_DATABASE=unused
MYSQL_SYNCHRONIZE=false
MYSQL_LOGGING=false

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DATABASE=crawler_db_v2
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_SSL=false

# 演示部署共用同一 PostgreSQL 服务，但保留独立连接名。
CRAWLER_DB_HOST=postgres
CRAWLER_DB_PORT=5432
CRAWLER_DB_USERNAME=postgres
CRAWLER_DB_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
CRAWLER_DB_DATABASE=crawler_db_v2
CRAWLER_DB_SYNCHRONIZE=false
CRAWLER_DB_LOGGING=false
CRAWLER_DB_SSL=false

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_TTL=3600

LOG_LEVEL=info
LOG_FILE_PATH=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
CACHE_TTL=300
CACHE_MAX=1000
UPLOAD_DEST=uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
DEBUG=false
HOT_RELOAD=false
API_DOCS_ENABLED=false
