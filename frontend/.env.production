VITE_BASE=/

VITE_GLOB_API_URL=/api

# V2 API 接口地址（使用版本控制）
VITE_GLOB_API_V2_URL=/api

# 后端 API 服务器地址（生产环境）
VITE_API_BASE_URL=http://192.168.102.168:9000

# 爬虫服务 API 地址（生产环境）
VITE_CRAWLER_API_BASE_URL=/crawler-api
# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
