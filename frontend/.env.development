# 应用标题
VITE_APP_TITLE=省广星芒系统

# 端口号
VITE_PORT=5777

VITE_BASE=/

# 接口地址（使用同源+Vite代理，避免跨域/CORS）
VITE_GLOB_API_URL=/api

# V2 API 接口地址（统一使用/api前缀）
VITE_GLOB_API_V2_URL=/api

# 后端 API 服务器地址（基础地址，不含 /api 前缀）
VITE_API_BASE_URL=http://localhost:9000
# VITE_API_BASE_URL=http://192.168.102.168:9000

# 爬虫服务 API 地址
VITE_CRAWLER_API_BASE_URL=http://localhost:8009/api/v1

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=true

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 路由模式：hash 或 history
VITE_ROUTER_HISTORY=hash
