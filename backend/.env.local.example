# 本地开发环境配置示例
# 复制此文件为 .env.local 并根据您的本地环境进行配置

# 应用配置
APP_NAME=智能达人推荐系统
APP_VERSION=1.0.0
NODE_ENV=development
PORT=9000
API_PREFIX=api/v1

# JWT配置 - 开发环境可使用简单密钥
JWT_SECRET=dev-jwt-secret-key-for-local-development-only
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=dev-refresh-secret-key-for-local-development-only
JWT_REFRESH_EXPIRES_IN=7d

# MySQL数据库配置 - 本地开发
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=gimcstar_system_dev
MYSQL_SYNCHRONIZE=true
MYSQL_LOGGING=true

# PostgreSQL数据库配置 - 本地开发
POSTGRES_HOST=192.168.102.168
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=crawler_db_v2
POSTGRES_SYNCHRONIZE=true
POSTGRES_LOGGING=true

# Redis配置 - 本地开发
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_TTL=3600

# 日志配置 - 开发环境详细日志
LOG_LEVEL=debug
LOG_FILE_PATH=logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7d
LOG_DATE_PATTERN=YYYY-MM-DD

# 缓存配置 - 开发环境
CACHE_TTL=60
CACHE_MAX=50

# 文件上传配置
UPLOAD_DEST=uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# 邮件配置 - 开发环境可使用测试邮箱
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=test@example.com
MAIL_PASS=test-password
MAIL_FROM=noreply@localhost

# 第三方API配置 - 开发环境
OPENAI_API_KEY=sk-test-key-for-development
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=500

# 搜索引擎配置 - 开发环境可选
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# 监控配置 - 开发环境
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=false
PROMETHEUS_PORT=9090

# 安全配置 - 开发环境
CORS_ORIGIN=http://localhost:5778
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=1000
ENCRYPTION_KEY=dev-encryption-key-32-chars-long

# 开发配置
DEBUG=true
HOT_RELOAD=true
API_DOCS_ENABLED=true
SWAGGER_PATH=docs