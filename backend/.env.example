# 应用配置
APP_NAME=智能达人推荐系统
APP_VERSION=1.0.0
NODE_ENV=development
PORT=9000
API_PREFIX=api/v1

# JWT配置 - 请在生产环境中更换为强密钥
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=30d

# MySQL数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=gimcstar_system
MYSQL_SYNCHRONIZE=false
MYSQL_LOGGING=false

# PostgreSQL数据库配置
POSTGRES_HOST=192.168.102.168
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=crawler_db_v2
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false

# 爬虫数据库配置（第二数据源）
CRAWLER_DB_HOST=192.168.102.168
CRAWLER_DB_PORT=5432
CRAWLER_DB_USERNAME=postgres
CRAWLER_DB_PASSWORD=postgres
CRAWLER_DB_DATABASE=crawler_db_v2
CRAWLER_DB_SYNCHRONIZE=false
CRAWLER_DB_LOGGING=false

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# 日志配置
LOG_LEVEL=info
LOG_FILE_PATH=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_DATE_PATTERN=YYYY-MM-DD

# 缓存配置
CACHE_TTL=300
CACHE_MAX=100

# 文件上传配置
UPLOAD_DEST=uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# 邮件配置 - 请配置您的邮件服务
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-email-password
MAIL_FROM=noreply@gimcstar.com

# 第三方API配置 - 请配置您的API密钥
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000

# 搜索引擎配置 - 可选
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# 监控配置
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# 安全配置 - 请根据您的前端域名配置
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
ENCRYPTION_KEY=your-32-character-encryption-key-here

# 开发配置
DEBUG=true
HOT_RELOAD=true
API_DOCS_ENABLED=true
SWAGGER_PATH=docs