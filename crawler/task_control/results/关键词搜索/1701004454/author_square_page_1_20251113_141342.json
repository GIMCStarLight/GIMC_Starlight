        "last_10_items": "[{\"comment_cnt\":\"99\",\"is_high_quality_item\":\"0\",\"item_create_time\":\"1760522437\",\"item_id\":\"7561386275552005422\",\"item_publish_time\":\"1760522437\",\"item_title\":\"挑战在上海疯炫一顿四种不同做法的马肉#老外在中国#麦炫疯#哈萨克斯坦美食#马肉#地方特色美食\",\"like_cnt\":\"5438\",\"share_cnt\":\"320\",\"vv\":\"51559\"},{\"comment_cnt\":\"139\",\"is_high_quality_item\":\"0\",\"item_create_time\":\"1759396288\",\"item_id\":\"7556549454338346240\",\"item_publish_time\":\"1759396288\",\"item_title\":\"谁说上海没有美食，对中国菜的认知又被打破啦！#魔都美食 #本帮菜 #国庆给生活分点红 #国庆美食特辑上刊了 #下饭神器\",\"like_cnt\":\"22620\",\"share_cnt\":\"475\",\"vv\":\"339151\"},{\"comment_cnt\":\"345\",\"is_high_quality_item\":\"0\",\"item_create_time\":\"1759296648\",\"item_id\":\"7556121553345137929\",\"item_publish_time\":\"1759296648\",\"item_title\":\"给你看看老外在中国，花60元就能体验到的快乐，给我看傻了！#给国庆分点红#国庆哪里红去哪里#打卡太湖龙之梦#老外黄金周涌入江浙沪#60元在江浙沪都能干啥\",\"like_cnt\":\"63427\",\"share_cnt\":\"1490\",\"vv\":\"372719\"},{\"comment_cnt\":\"434\",\"is_high_quality_item\":\"0\",\"item_create_time\":\"1759160351\",\"item_id\":\"7555536161059261722\",\"item_publish_time\":\"1759160351\",\"item_title\":\"有没有好心人帮我算一算，今天这顿海鲜自助我吃回本了吗？#麦炫疯 #南方人的国庆逛吃指南 #海鲜自助\",\"like_cnt\":\"23483\",\"share_cnt\":\"2774\",\"vv\":\"414101\"},{\"comment_cnt\":\"335\",\"is_high_quality_item\":\"0\",\"item_create_time\":\"1759130344\",\"item_id\":\"7555407279260994842\",\"item_publish_time\":\"1759130344\",\"item_title\":\"国庆你们去哪过呀，我已经找到了我的宝藏小城，居然有比湖南还辣的地方！！！#国庆小城正当红 #国庆给生活分点红 #河南 #德庄火锅 #德庄全辣度你吃多少度\",\"like_cnt\":\"17187\",\"share_cnt\":\"429\",\"vv\":\"168443\"},{\"comment_cnt\":\"246\",\"is_high_quality_item\":\"0\",\"item_create_time\":\"1758975215\",\"item_id\":\"7554741012879740210\",\"item_publish_time\":\"1758975215\",\"item_title\":\"挑战花379元，疯炫价值3000的海鲜自助#自助#老外在中国#海鲜#自助餐的正确吃法#亚马逊海鲜自助\",\"like_cnt\":\"16981\",\"share_cnt\":\"1071\",\"vv\":\"345486\"},{\"comment_cnt\":\"691\",\"is_high_quality_item\":\"0\",\"item_create_time\":\"1758417989\",\"item_id\":\"7552347744007589177\",\"item_publish_time\":\"1758417989\",\"item_title\":\"100块在上海交通大学能吃啥？#交大食堂 #外国人在中国 #大学食堂阿姨不手抖 #上海物价#蛋卷王\",\"like_cnt\":\"50416\",\"share_cnt\":\"5472\",\"vv\":\"1256648\"},{\"comment_cnt\":\"217\",\"is_high_quality_item\":\"0\",\"item_create_time\":\"1758260713\",\"item_id\":\"7551672217877155124\",\"item_publish_time\":\"1758260713\",\"item_title\":\"1000块在上海吃漂亮饭，你们不知道我的胃口有多大吗？#王老吉WALOV I#冰中式火爆全球 #上海漂亮饭 #外国人在中国\",\"like_cnt\":\"18292\",\"share_cnt\":\"500\",\"vv\":\"209334\"},{\"comment_cnt\":\"286\",\"is_high_quality_item\":\"0\",\"item_create_time\":\"1758250109\",\"item_id\":\"7551626697960131891\",\"item_publish_time\":\"1758250109\",\"item_title\":\"挑战疯炫长沙美食，看吃饱要花多少钱#柚香柚爽柚啤气 #老外爱上宋柚汁 #宋柚汁热辣寻百店#夜市#湖南辣\",\"like_cnt\":\"22066\",\"share_cnt\":\"1170\",\"vv\":\"281163\"},{\"comment_cnt\":\"488\",\"is_high_quality_item\":\"0\",\"item_create_time\":\"1758103801\",\"item_id\":\"7550998326431599931\",\"item_publish_time\":\"1758103801\",\"item_title\":\"街边小吃真的非常美味，上海如果也有这样的早市就好了～#交出你的宝藏烟火小店 #寻味烟火气 #长沙美食 #早市的烟火气 #外国人吃中国美食\",\"like_cnt\":\"41746\",\"share_cnt\":\"2327\",\"vv\":\"1098405\"}]",
