# PostgreSQL 连接配置（旧示例字段，兼容保留）
POSTGRES_HOST=192.168.102.168
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crawler_db_v2

# PostgreSQL 统一配置字段（新）
# 与脚本内部使用一致；两套字段任选其一即可
PG_HOST=192.168.102.168
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=crawler_db_v2

# 限速与时间窗口
# 并发任务数（计划内并发提交）
CONCURRENCY=2
# 每秒域级请求数（不设置表示禁用统一限速）
DOMAIN_QPS=2
# QPS 时间窗口毫秒
QPS_WINDOW_MS=1000
# 任务执行时间窗（示例：02:00-06:00）
TIME_WINDOW=

# 429/403 额外冷却毫秒
COOLDOWN_429_403_MS=2000

# 终止条件（可选）
# 全局失败率阈值（0.0-1.0），达到或超过则停止
MAX_FAILURE_RATE=0.6
# 连续空作者页达到 N 次停止
STOP_WHEN_EMPTY_N=3
# 连续 401 阈值与暂停毫秒数
MAX_CONSECUTIVE_401=3
PAUSE_ON_401_MS=60000

# 运行参数（可选）
# Cookies 文件路径
COOKIES_FILE=
# Star ID
STAR_ID=1843934177451019
# 输出目录
OUTPUT_DIR=
# 视频类型与搜索类型
VIDEO_TYPE=2
SEARCH_TYPE=2
# 排序字段与类型
SORT_FIELD=score
SORT_TYPE=2
# 省市筛选（可填 ID 或名称；名称优先）
PROVINCE_ID=
CITY_ID=
PROVINCE_NAME=
CITY_NAME=
# 额外过滤（逗号分隔，如：live,hot_videos）
EXTRA_FILTERS=

# PG 保存与配置
SAVE_PG=false
PG_CONFIG=

# 指标与智能页数
METRICS_PORT=
AUTO_PAGES=false
AUTO_PAGES_UPPER_BOUND=

# 执行策略
RESUME=false
SKIP_EXISTING=false
RERUN_FAILED=false

# 计划输出路径（设置此值可覆盖默认）
# 默认路径：reports/jobs_plan.json（每次覆盖）
# 若你希望保留按时间戳归档，可在运行时传：
# --jobs-plan-out config/jobs_plan_$(date +%Y%m%d_%H%M%S).json
JOBS_PLAN_OUT=