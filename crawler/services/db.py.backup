def _safe_int(v):
    try:
        if v is None:
            return None
        s = str(v).strip()
        if not s:
            return None
        return int(float(s))
    except Exception:
        return None


def _safe_float(v):
    try:
        if v is None:
            return None
        s = str(v).strip()
        if not s:
            return None
        return float(s)
    except Exception:
        return None


def _safe_bool(v):
    try:
        if v is None:
            return None
        s = str(v).strip().lower()
        if s in ("1", "true", "t", "yes", "y"):
            return True
        if s in ("0", "false", "f", "no", "n"):
            return False
        if s and s.isdigit():
            return int(s) != 0
        return None
    except Exception:
        return None


def _maybe_json(v):
    if v is None:
        return None
    if isinstance(v, (dict, list)):
        return v
    s = str(v).strip()
    if not s:
        return None
    if (s.startswith("{") and s.endswith("}")) or (s.startswith("[") and s.endswith("]")):
        try:
            return json.loads(s)
        except Exception:
            return None
    return None


class PgSaver:
    def __init__(self, config_path: str | None = None):
        self.config_path = config_path
        self.conn = None
        self.keys = list(FIXED_KEYS)
        self.type_map = self._build_type_map(self.keys)

    def connect(self):
        cfg = self._load_pg_config()
        self.conn = psycopg2.connect(
            host=cfg.get("host"),
            port=cfg.get("port"),
            user=cfg.get("user"),
            password=cfg.get("password"),
            dbname=cfg.get("database"),
        )

    def close(self):
        try:
            if self.conn:
                self.conn.close()
        except Exception:
            pass

    def _load_pg_config(self) -> dict:
        # 优先使用显式传入路径；否则尝试包根目录下 config/postgres.json
        if self.config_path and os.path.exists(self.config_path):
            try:
                with open(self.config_path, "r", encoding="utf-8") as f:
                    return json.load(f)
            except Exception:
                pass
        # 在 services 层，默认配置位于包根目录 ../config/postgres.json
        pkg_root = os.path.dirname(os.path.dirname(__file__))
        guess = os.path.join(pkg_root, "config", "postgres.json")
        if os.path.exists(guess):
            with open(guess, "r", encoding="utf-8") as f:
                return json.load(f)
        return {}

    def _build_type_map(self, keys: list[str]) -> dict:
        jsonb_keys = set(
            [
                "tags_relation",
                "last_10_items",
                "content_theme_labels_180d",
                "assign_task_price_list",
                "enroll_task_price_list",
                "author_thin_mid_word_association_index",
