                "link_spread_index_by_industry",
                "link_star_index_by_industry",
                "link_user_type_by_industry",
                "link_i_cnt_by_industry",
                "link_k_cnt_by_industry",
                "link_l_cnt_by_industry",
                "link_link_cnt_by_industry",
                "link_n_cnt_by_industry",
                "avg_sale_amount_range",
                "ecom_avg_order_value_30d_range",
                "ecom_gmv_30d_range",
                "ecom_gpm_30d_range",
                "ecom_gpm_30days_range",
                "median_game_item_component_click_range",
                "median_game_item_cpc_range",
                "median_content_item_component_click_range",
                "median_content_item_cpc_range",
                "median_tool_item_component_click_range",
                "median_tool_item_cpc_range",
                "ecom_video_ctr_30d_range",
                "ecom_video_mid_click_pv_30d_range",
                "median_game_item_cpc_90_days_range",
            ]
        )

        boolean_keys = {k for k in keys if k.startswith("is_")}
        boolean_keys |= set(
            [
                "e_commerce_enable",
                "local_lower_threshold_author",
                "is_short_drama",
                "star_excellent_author",
                "star_qianchuan_high_potential",
                "star_whispers_author",
            ]
        )

        integer_keys = set(
            [
                "gender",
                "author_type",
                "author_status",
                "grade",
                "expected_cpa3_level",
            ]
        )

        bigint_keys = set(
            [
                "id",
                "core_user_id",
                "follower",
                "star_item_count_within_30d",
                "star_video_cnt_90d",
                "star_video_install_ge_1_cnt_90d",
                "star_component_link_click_cnt_90d",
                "game_item_count_90d",
                "tool_item_count_90d",
                "ecom_watch_pv_30d",
                "star_ecom_video_product_num_30d",
                "star_ecom_video_num_30d",
                "pic_expected_play_num",
                "expected_natural_play_num",
                "sn_expected_play_num",
            ]
        )

        double_keys = set(
            [
                "vv_median_30d",
                "interact_rate_within_30d",
                "play_over_rate_within_30d",
                "sn_interact_rate_within_30d",
                "sn_play_over_rate_within_30d",
                "assign_cpm_suggest_price",
                "brand_boost_vv",
                "pic_brand_boost_vv",
                "video_brand_boost_vv",
                "video_brand_boost",
                "star_index",
                "link_convert_index",
                "link_shopping_index",
                "link_spread_index",
                "link_star_index",
                "avg_search_after_view_rate_30d",
                "burst_text_rate",
                "ecom_score",
                "star_component_download_ctr_90d",
                "star_component_install_cpa_90d",
                "star_component_install_pvr_90d",
                "star_video_finish_vv_rate_90d",
                "star_video_interact_rate_90d",
                "promotion_prospective_1_20_cpm",
                "promotion_prospective_20_60_cpm",
                "promotion_prospective_60_cpm",
                "promotion_prospective_vv",
                "prospective_1_20_cpm",
                "prospective_20_60_cpm",
                "prospective_60_cpm",
                "sn_prospective_1_20_cpe",
                "sn_prospective_1_20_cpm",
                "sn_prospective_20_60_cpe",
                "sn_prospective_20_60_cpm",
                "sn_prospective_60_cpe",
                "sn_prospective_60_cpm",
                "expected_cpa3_level",
                "expected_play_num",
                "price_1_20",
                "price_20_60",
                "price_60",
                "star_ecom_main_price_30days",
                "fans_increment_within_15d",
                "fans_increment_within_30d",
                "fans_increment_rate_within_15d",
                "link_convert_index_by_industry",
                "link_recommend_index_by_industry",
                "link_spread_index_by_industry",
                "link_star_index_by_industry",
                "pic_expected_cpm",
            ]
        )

        text_keys = set(
            [
                "author_avatar_frame_icon",
                "avatar_uri",
                "city",
                "province",
                "nick_name",
                "game_type",
                "search_after_view_index_by_industry",
            ]
        )

        tmap: dict = {}
        for k in keys:
            if k in jsonb_keys:
                tmap[k] = "jsonb"
            elif k in boolean_keys:
                tmap[k] = "boolean"
            elif k in integer_keys:
                tmap[k] = "integer"
            elif k in bigint_keys:
                tmap[k] = "bigint"
            elif k in double_keys:
                tmap[k] = "double precision"
            elif k in text_keys:
                tmap[k] = "text"
            else:
                tmap[k] = "text"
        return tmap

    def ensure_schema(self):
        cur = None
        try:
            cur = self.conn.cursor()

            cur.execute(
                """
                CREATE TABLE IF NOT EXISTS author_square_runs (
                    id BIGSERIAL PRIMARY KEY,
                    first_label TEXT,
                    second_label TEXT,
                    second_ids JSONB,
                    video_type TEXT,
                    page INTEGER,
                    "limit" INTEGER,
                    min_price BIGINT,
                    x_tt_agw_login TEXT,
                    request_payload JSONB,
                    request_payload_hash TEXT,
                    created_at TIMESTAMP DEFAULT NOW()
                );
                """
            )

            cur.execute(
                """
                CREATE TABLE IF NOT EXISTS author_square_authors (
                    id BIGSERIAL PRIMARY KEY,
                    run_id BIGINT REFERENCES author_square_runs(id) ON DELETE CASCADE,
                    author_id TEXT,
                    star_id TEXT,
                    core_user_id BIGINT,
                    raw_attribute_datas JSONB,
                    created_at TIMESTAMP DEFAULT NOW(),
                    UNIQUE(run_id, author_id)
                );
                """
            )

            cur.execute(
                """
                CREATE TABLE IF NOT EXISTS author_dimension (
                    author_id TEXT PRIMARY KEY,
                    star_id TEXT,
                    core_user_id BIGINT,
                    last_seen_run_id BIGINT,
                    updated_at TIMESTAMP DEFAULT NOW()
                );
                """
            )

            cur.execute(
                """
                CREATE TABLE IF NOT EXISTS author_square_summaries (
                    id BIGSERIAL PRIMARY KEY,
                    first_label TEXT,
                    second_label TEXT,
                    second_ids JSONB,
                    video_type TEXT,
                    start_page INTEGER,
                    pages_done INTEGER,
                    authors_total INTEGER,
                    failed_pages INTEGER,
                    report_path TEXT,
                    started_at TIMESTAMP,
                    finished_at TIMESTAMP,
                    created_at TIMESTAMP DEFAULT NOW()
                );
                """
            )

            for tbl in ("author_square_authors", "author_dimension"):
                for k, typ in self.type_map.items():
                    cur.execute(f'ALTER TABLE {tbl} ADD COLUMN IF NOT EXISTS "{k}" {typ};')

            cur.execute(
                """
                CREATE INDEX IF NOT EXISTS idx_author_square_authors_run_id ON author_square_authors(run_id);
                CREATE INDEX IF NOT EXISTS idx_author_square_authors_author_id ON author_square_authors(author_id);
                CREATE INDEX IF NOT EXISTS idx_author_dimension_star_id ON author_dimension(star_id);
                """
            )

            self.conn.commit()
        except Exception:
            try:
                self.conn.rollback()
            except Exception:
                pass
            raise
        finally:
            try:
                if cur:
                    cur.close()
            except Exception:
                pass

    def _compute_payload_hash(self, payload: dict | None) -> str | None:
        if not payload:
            return None
        try:
            s = json.dumps(payload, ensure_ascii=False, sort_keys=True)
            return hashlib.sha256(s.encode("utf-8")).hexdigest()
        except Exception:
            return None

    def _parse_attribute_datas(self, attr: dict) -> tuple[dict, dict]:
        if not isinstance(attr, dict):
            attr = {}
        norm: dict = {}
        jsonvals: dict = {}
        for k, typ in self.type_map.items():
            v = attr.get(k)
            if typ == "jsonb":
                json_obj = _maybe_json(v)
                if json_obj is not None:
                    jsonvals[k] = json_obj
                else:
                    if v is not None and str(v).strip():
                        norm[k] = str(v)
                continue
            if v is None:
                continue
            if typ == "boolean":
                bv = _safe_bool(v)
                if bv is not None:
                    norm[k] = bv
            elif typ == "integer":
                iv = _safe_int(v)
                if iv is not None:
                    norm[k] = iv
            elif typ == "bigint":
                iv = _safe_int(v)
                if iv is not None:
                    norm[k] = iv
            elif typ == "double precision":
                fv = _safe_float(v)
                if fv is not None:
                    norm[k] = fv
            else:
                s = str(v)
                if s:
                    norm[k] = s
        return norm, jsonvals

    def save_run_and_authors(
        self,
        first_label: str,
        second_label: str,
        second_ids: list,
        video_type: str,
        page: int,
        limit: int,
        min_price: int,
        x_tt_agw_login: str | None,
        request_payload: dict,
        response: dict,
    ) -> int:
        cur = None
        try:
            cur = self.conn.cursor()

            payload_hash = self._compute_payload_hash(request_payload)
            cur.execute(
                """
                INSERT INTO author_square_runs (
                    first_label, second_label, second_ids, video_type, page, "limit", min_price,
                    x_tt_agw_login, request_payload, request_payload_hash
                ) VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s)
                RETURNING id
                """,
                (
                    first_label,
                    second_label,
                    psycopg2.extras.Json(second_ids),
                    str(video_type) if video_type is not None else None,
                    int(page) if page is not None else None,
                    int(limit) if limit is not None else None,
                    _safe_int(min_price),
                    x_tt_agw_login,
                    psycopg2.extras.Json(request_payload) if isinstance(request_payload, dict) else None,
                    payload_hash,
                ),
            )
            run_id = cur.fetchone()[0]

            authors = (response or {}).get("authors") or []
            for author in authors:
                attr = {}
                try:
                    attr = author.get("attribute_datas") or {}
                except Exception:
                    attr = {}

                star_id = None
                try:
                    star_id = author.get("star_id")
                except Exception:
                    pass
                author_id = attr.get("id") or author.get("author_id") or star_id
                if author_id is None:
                    continue
                author_id_str = str(author_id)

                norm, jsonvals = self._parse_attribute_datas(attr)

                base_cols = [
                    ("run_id", run_id),
                    ("author_id", author_id_str),
                    ("star_id", str(star_id) if star_id is not None else None),
                    ("core_user_id", _safe_int(attr.get("core_user_id"))),
                    ("raw_attribute_datas", psycopg2.extras.Json(attr) if attr else None),
                ]

                insert_cols = [c for c, _ in base_cols]
                insert_vals = [v for _, v in base_cols]
                existing_cols = set(insert_cols)
                reserved_authors_cols = {"id"}
                for k, v in norm.items():
                    if k in existing_cols or k in reserved_authors_cols:
                        continue
                    insert_cols.append(k)
                    insert_vals.append(psycopg2.extras.Json(v) if self.type_map.get(k) == "jsonb" else v)
                for k, v in jsonvals.items():
                    if k in existing_cols or k in reserved_authors_cols:
                        continue
                    insert_cols.append(k)
                    insert_vals.append(psycopg2.extras.Json(v))

                cols_sql = ",".join([f'"{c}"' for c in insert_cols])
                placeholders = ",".join(["%s"] * len(insert_vals))
                cur.execute(
                    f"""
                    INSERT INTO author_square_authors ({cols_sql})
                    VALUES ({placeholders})
                    ON CONFLICT (run_id, author_id) DO UPDATE SET
                        raw_attribute_datas = EXCLUDED.raw_attribute_datas
                    """,
                    insert_vals,
                )

                dim_cols = [
                    ("author_id", author_id_str),
                    ("star_id", str(star_id) if star_id is not None else None),
                    ("core_user_id", _safe_int(attr.get("core_user_id"))),
                    ("last_seen_run_id", run_id),
                    ("updated_at", datetime.now()),
                ]
                existing_dim_cols = set(c for c, _ in dim_cols)
                for k, v in norm.items():
                    if k in existing_dim_cols:
                        continue
                    dim_cols.append((k, psycopg2.extras.Json(v) if self.type_map.get(k) == "jsonb" else v))
                for k, v in jsonvals.items():
                    if k in existing_dim_cols:
                        continue
                    dim_cols.append((k, psycopg2.extras.Json(v)))

                dcols_sql = ",".join([f'"{c}"' for c, _ in dim_cols])
                dvals = [v for _, v in dim_cols]
                dph = ",".join(["%s"] * len(dvals))
                update_set = ",".join([f'"{c}" = EXCLUDED."{c}"' for c, _ in dim_cols if c != "author_id"])
                cur.execute(
                    f"""
                    INSERT INTO author_dimension ({dcols_sql})
                    VALUES ({dph})
                    ON CONFLICT (author_id) DO UPDATE SET
                        {update_set}
                    """,
                    dvals,
                )

            self.conn.commit()
            return run_id
        except Exception:
            try:
                self.conn.rollback()
            except Exception:
                pass
            raise
        finally:
            try:
                if cur:
                    cur.close()
            except Exception:
                pass

    def save_summary(
        self,
        first_label: str,
        second_label: str,
        second_ids: list,
        video_type: str,
        start_page: int,
        pages_done: int,
        authors_total: int,
        failed_pages: int,
        report_path: str | None,
        started_at: datetime,
        finished_at: datetime,
    ) -> int:
        cur = None
        try:
            cur = self.conn.cursor()
            cur.execute(
                """
                INSERT INTO author_square_summaries (
                    first_label, second_label, second_ids, video_type,
                    start_page, pages_done, authors_total, failed_pages,
                    report_path, started_at, finished_at
                ) VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)
                RETURNING id
                """,
                (
                    first_label,
                    second_label,
                    psycopg2.extras.Json(second_ids),
                    str(video_type) if video_type is not None else None,
                    _safe_int(start_page),
                    _safe_int(pages_done),
                    _safe_int(authors_total),
                    _safe_int(failed_pages),
                    report_path,
                    started_at,
                    finished_at,
                ),
            )
            summary_id = cur.fetchone()[0]
            self.conn.commit()
            return summary_id
        except Exception:
            try:
                self.conn.rollback()
            except Exception:
                pass
            raise
        finally:
            try:
                if cur:
                    cur.close()
            except Exception:
                pass